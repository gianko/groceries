# Dependencias y build — se reinstalan/recompilan dentro de la imagen
node_modules
dist
.pnpm-store

# .git is needed by the gitinfo build stage (build-info.json for /ping) —
# only that stage COPYs it in, so it never reaches deps/build or the final
# image. .gitignore/.github aren't needed anywhere in the build.
.gitignore
.github

# Secretos: nunca en el contexto de build
.env
.env.*
!.env.example

# Datos locales y artefactos de runtime
*.db
*.db-wal
*.db-shm
*.sqlite
heartbeat
data/

# Tooling y editor
.vscode
.idea
.DS_Store
*.log
coverage
.eslintcache

# Docs y config que no entran en la imagen
docker-compose.yml
.dockerignore
Dockerfile
README.md
docs/