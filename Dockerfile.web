# syntax=docker/dockerfile:1
#
# Builds the Mini App server (pantry-web): an Astro + Preact SSR app that
# imports the bot's own domain code (src/*.ts) directly per #25 — no API
# layer, no separate package.json. Built for the household Pi (arm64) via
# multi-arch buildx, same as the main Dockerfile.

FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

# better-sqlite3 needs a native build step (node-gyp -> python3/make/g++),
# same as the bot image.
FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts && pnpm rebuild better-sqlite3

FROM deps AS build
COPY tsconfig.json ./
COPY src ./src
COPY drizzle ./drizzle
COPY web ./web
RUN pnpm web:build

FROM deps AS prod-deps
RUN pnpm install --frozen-lockfile --prod --ignore-scripts && pnpm rebuild better-sqlite3

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/web/dist ./web/dist
COPY drizzle ./drizzle
COPY package.json ./

RUN useradd --system --uid 1001 --create-home pantry \
  && mkdir -p /data \
  && chown -R pantry:pantry /data
USER pantry

VOLUME ["/data"]

# No inbound port published to the host — only cloudflared's sidecar
# container reaches this over the compose network, per #22.
CMD ["node", "web/dist/server/entry.mjs"]
