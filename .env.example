# Copy to .env (gitignored) and fill in real values. Never commit .env.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Comma-separated Telegram user IDs of the two household members.
ALLOWED_USER_IDS=
GROUP_CHAT_ID=
TZ=Europe/Dublin

# Optional ops overrides — defaults below match docker-compose.yml.
# HEARTBEAT_INTERVAL_MS=30000
# HEARTBEAT_STALE_MS=90000
# SNAPSHOT_CRON=0 3 * * *
# DIGEST_CRON=0 17 * * *

# Dev-only: skip real Gemini calls and use FakeBrain's canned responses
# (avoids burning API quota / hitting rate limits while testing the bot).
# FAKE_GEMINI=1

# Mini App (pantry-web + cloudflared), per #19/#22. Token for the named
# Cloudflare Tunnel from the Zero Trust dashboard (Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# Public HTTPS URL the tunnel maps to pantry-web — used by the bot to build
# the web_app buttons that open the Mini App from chat.
WEB_APP_URL=
