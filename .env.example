# Copy to .env (gitignored) and fill in real values. Never commit .env.
GROQ_API_KEY=
TZ=Europe/Dublin

# Optional ops overrides — defaults below match docker-compose.yml.
# HEARTBEAT_INTERVAL_MS=30000
# HEARTBEAT_STALE_MS=90000
# SNAPSHOT_CRON=0 3 * * *

# Dev-only: skip real Groq calls and use FakeBrain's canned responses
# (avoids burning API quota / hitting rate limits while testing).
# FAKE_BRAIN=1

# Named Cloudflare Tunnel fronting pantry-web, per #19/#22. Token from the
# tunnel's Zero Trust dashboard (Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# Public HTTPS URL the tunnel maps to pantry-web — used to build bootstrap
# links (see src/scripts/mint-token.ts).
WEB_APP_URL=
