---
import { fetchPersonTokens } from "../../../../src/personTokens.js";
import { PERSON_TOKEN_COOKIE, validatePersonToken } from "../../lib/personAuth.js";
import { getDb } from "../../lib/webDb.js";

// The one-time bootstrap link (#45): mint-token.ts prints
// `${webAppUrl}/bootstrap/${token}`, and visiting it here is the only place
// the cookie ever gets its first value. Middleware exempts this whole path
// from its own gate, so an invalid token has to be rejected here explicitly
// rather than falling through to the generic 401.
const { token } = Astro.params;
const db = getDb();
const result = validatePersonToken(token ?? "", fetchPersonTokens(db), new Date());

if (!result.valid) {
  return new Response(
    "<!doctype html><html><head><title>Pantry</title></head><body>" +
      "<p>This bootstrap link is invalid. Ask whoever set up the household " +
      "Pi to mint you a new one.</p></body></html>",
    { status: 401, headers: { "content-type": "text/html" } },
  );
}

Astro.cookies.set(PERSON_TOKEN_COOKIE, token!, {
  httpOnly: true,
  secure: true,
  sameSite: "lax",
  path: "/",
  expires: result.expiresAt,
});

return Astro.redirect("/");
---
