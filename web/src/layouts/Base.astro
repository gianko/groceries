---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f4f4f2;
        --card: #ffffff;
        --ink: #1c1c1e;
        --muted: #8a8a8e;
        --line: #e5e5e7;
        --accent: #007aff;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        -webkit-tap-highlight-color: transparent;
      }
      #app {
        max-width: 420px;
        margin: 0 auto;
        min-height: 100vh;
        padding-bottom: 96px;
      }
      .screen-head {
        padding: 16px 16px 10px;
        border-bottom: 1px solid var(--line);
      }
      .screen-head h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
      }
      .section-head {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 18px 16px 6px;
        margin: 0;
      }
      .lot-list {
        list-style: none;
        margin: 0 12px;
        padding: 0;
        background: var(--card);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }
      .lot-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-bottom: 1px solid var(--line);
      }
      li:last-child .lot-row {
        border-bottom: none;
      }
      .lot-name {
        flex: 1;
        font-size: 15px;
      }
      .lot-meta {
        font-size: 13px;
        color: var(--muted);
      }
      .notice {
        margin: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #fff3cd;
        color: #664d03;
        font-size: 14px;
      }
      .auto-relist-panel {
        margin: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        background: var(--card);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }
      .auto-relist-title {
        margin: 0 0 8px;
        font-size: 14px;
        font-weight: 600;
      }
      .auto-relist-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
      }
      .auto-relist-actions button {
        margin-left: 8px;
        padding: 6px 14px;
        border-radius: 8px;
        border: none;
        background: var(--accent);
        color: #fff;
        font-size: 13px;
      }
      .confirm-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        justify-content: center;
        padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
        background: rgba(244, 244, 242, 0.92);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--line);
      }
      .confirm-bar button {
        width: 100%;
        max-width: 388px;
        padding: 14px;
        border-radius: 12px;
        border: none;
        background: var(--accent);
        color: #fff;
        font-size: 16px;
        font-weight: 600;
      }
      .empty-state {
        margin: 0 16px;
        padding: 14px 2px;
        color: var(--muted);
        font-size: 14px;
      }
      .entry-row {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 12px 14px;
        border: none;
        background: none;
        text-align: left;
        font: inherit;
        color: inherit;
      }
      .entry-check {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--line);
        flex: none;
      }
      .entry-check.done {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
      }
      .entry-name {
        flex: 1;
        font-size: 15px;
      }
      .entry-name.done {
        text-decoration: line-through;
        color: var(--muted);
      }
      .tag {
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 20px;
        background: var(--bg);
        color: var(--muted);
      }
      .add-row {
        display: flex;
        gap: 8px;
        margin: 12px 12px 4px;
      }
      .add-row input {
        flex: 1;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 10px;
        font-size: 15px;
      }
      .add-row button {
        padding: 10px 16px;
        border: none;
        border-radius: 10px;
        background: var(--ink);
        color: #fff;
        font-size: 14px;
      }
      .add-row button:disabled {
        opacity: 0.5;
      }
      .signal-list {
        list-style: none;
        margin: 0 12px;
        padding: 0;
      }
      .signal-card {
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 12px;
        padding: 10px 12px;
        margin-bottom: 8px;
      }
      .signal-card.expiring {
        background: #fbe9dd;
      }
      .signal-card.guess {
        background: #e7ecf7;
      }
      .signal-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .signal-title {
        font-size: 14px;
        font-weight: 600;
      }
      .signal-meta {
        font-size: 12px;
        color: var(--muted);
        margin-top: 1px;
      }
      .signal-actions {
        display: flex;
        gap: 8px;
        flex: none;
      }
      .pill-btn {
        border: none;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 13px;
        flex: none;
      }
      .pill-btn.accept {
        background: var(--accent);
        color: #fff;
      }
      .pill-btn.dismiss {
        background: none;
        color: var(--muted);
        border: 1px solid var(--line);
      }
      .checked-off {
        margin: 18px 12px 0;
      }
      .checked-off summary {
        font-size: 13px;
        color: var(--muted);
        padding: 8px 4px;
      }
      .section-divider {
        margin: 20px 16px;
        border: none;
        border-top: 1px solid var(--line);
      }
      .prefs-field {
        margin: 0 12px 16px;
      }
      .prefs-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
      }
      .stepper {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--card);
        border-radius: 12px;
        padding: 8px 14px;
        width: fit-content;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }
      .stepper-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: var(--bg);
        color: var(--ink);
        font-size: 18px;
        line-height: 1;
      }
      .stepper-btn:disabled {
        opacity: 0.4;
      }
      .stepper-value {
        min-width: 20px;
        text-align: center;
        font-size: 16px;
        font-weight: 600;
      }
      .prefs-textarea {
        width: 100%;
        min-height: 88px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 10px;
        font: inherit;
        font-size: 15px;
        background: var(--card);
        resize: vertical;
      }
      .save-btn {
        display: block;
        width: calc(100% - 24px);
        margin: 4px 12px 12px;
        padding: 12px;
        border: none;
        border-radius: 12px;
        background: var(--accent);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
      }
      .save-btn:disabled {
        opacity: 0.5;
      }
      .recipe-list {
        list-style: none;
        margin: 0 12px;
        padding: 0;
        background: var(--card);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }
      .recipe-row {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 12px 14px;
        border: none;
        border-bottom: 1px solid var(--line);
        background: none;
        text-align: left;
        font: inherit;
        color: inherit;
      }
      li:last-child .recipe-row {
        border-bottom: none;
      }
      .recipe-icon {
        flex: none;
      }
      .recipe-main {
        flex: 1;
        min-width: 0;
      }
      .recipe-title {
        font-size: 15px;
      }
      .recipe-sub {
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .recipe-chev {
        color: var(--muted);
        flex: none;
      }
      .tag.missing {
        background: #fbe9dd;
        color: #b3541e;
      }
      .tag.gold {
        background: #fbf1d9;
        color: #a9791b;
      }
      .link-btn {
        border: none;
        background: none;
        color: var(--accent);
        font-size: 13px;
        font-weight: 600;
        padding: 0;
      }
      .section-head-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 16px 6px;
      }
      .section-head-row .section-head {
        padding: 0;
      }
      .modal-overlay {
        position: fixed;
        inset: 0;
        background: var(--bg);
        z-index: 20;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
      }
      .modal-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        background: var(--bg);
        z-index: 1;
      }
      .modal-back {
        border: none;
        background: none;
        font-size: 20px;
        color: var(--ink);
        padding: 0;
        line-height: 1;
      }
      .modal-title {
        font-weight: 700;
        font-size: 16px;
      }
      .modal-body {
        padding: 4px 16px 100px;
      }
      .tabs {
        display: flex;
        gap: 18px;
        border-bottom: 1px solid var(--line);
        margin: 10px 0 4px;
      }
      .tab {
        padding: 8px 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
      }
      .tab.active {
        color: var(--ink);
        border-bottom-color: var(--ink);
      }
      .ing-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
        font-size: 14px;
      }
      .ing-row:last-child {
        border-bottom: none;
      }
      .ing-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        flex: none;
        color: #fff;
        background: var(--accent);
      }
      .ing-dot.missing {
        background: #b3541e;
      }
      .ing-name {
        flex: 1;
      }
      .ing-qty {
        font-size: 12px;
        color: var(--muted);
      }
      .steps-list {
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: step;
      }
      .steps-list li {
        display: flex;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
        font-size: 14px;
        line-height: 1.4;
      }
      .steps-list li:last-child {
        border-bottom: none;
      }
      .steps-list li::before {
        counter-increment: step;
        content: counter(step);
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--bg);
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
      }
      .steps-empty {
        font-size: 13px;
        color: var(--muted);
        background: #fbe9dd;
        border-radius: 10px;
        padding: 10px 12px;
        margin-top: 4px;
      }
      .primary-btn {
        display: block;
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: var(--accent);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        margin-top: 16px;
      }
      .primary-btn:disabled {
        opacity: 0.5;
      }
      .ghost-btn {
        display: block;
        width: 100%;
        padding: 13px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: none;
        color: var(--ink);
        font-size: 14px;
        font-weight: 600;
        margin-top: 8px;
      }
      .ghost-btn:disabled {
        opacity: 0.5;
      }
      .result-block {
        margin-top: 18px;
      }
      .result-block h3 {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        margin: 0 0 8px;
      }
      .used-row {
        display: flex;
        justify-content: space-between;
        padding: 7px 0;
        font-size: 14px;
        border-bottom: 1px solid var(--line);
      }
      .used-row:last-child {
        border-bottom: none;
      }
      .fc-row {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px 0;
        border: none;
        border-bottom: 1px solid var(--line);
        background: none;
        text-align: left;
        font: inherit;
        color: inherit;
      }
      .fc-row:last-child {
        border-bottom: none;
      }
      .fc-check {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--line);
        flex: none;
      }
      .fc-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 10px;
      }
      .fc-bar button {
        padding: 8px 16px;
        border: none;
        border-radius: 10px;
        background: var(--accent);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
      }
      .fc-bar button:disabled {
        opacity: 0.5;
      }
      .rate-block {
        margin-top: 20px;
        text-align: center;
      }
      .rate-block p {
        font-size: 13px;
        color: var(--muted);
        margin: 0 0 8px;
      }
      .rate-btns {
        display: flex;
        justify-content: center;
        gap: 16px;
      }
      .rate-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid var(--line);
        background: var(--card);
        font-size: 20px;
      }
      .rate-btn.picked {
        border-color: var(--accent);
        background: var(--accent-soft, #e4f2e9);
      }
      .rate-thanks {
        font-size: 13px;
        color: var(--muted);
        margin-top: 8px;
      }
    </style>
  </head>
  <body>
    <div id="app">
      <slot />
    </div>
  </body>
</html>
